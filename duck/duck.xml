<mujoco model="microduck_test">

    <compiler angle="radian" autolimits="true"/>

    <option
        timestep="0.002"
        gravity="0 0 -9.81"
        integrator="implicitfast"/>

    <default>

        <joint
            damping="0.15"
            armature="0.002"/>

        <geom
            condim="3"
            friction="1.0 0.5 0.5"/>

        <position
            kp="15"/>

    </default>


    <!-- ====================================================== -->
    <!-- WORLD                                                   -->
    <!-- ====================================================== -->

    <worldbody>

        <light
            pos="0 0 3"
            dir="0 0 -1"/>

        <geom
            name="floor"
            type="plane"
            size="5 5 0.1"/>


        <!-- ================================================== -->
        <!-- MICRODUCK BODY                                     -->
        <!-- ================================================== -->

        <body
            name="trunk"
            pos="0 0 0.42">

            <!-- Floating robot -->
            <freejoint name="root"/>

            <!-- Main body -->
            <geom
                name="trunk_collision"
                type="box"
                pos="0 0 0"
                size="0.115 0.075 0.10"
                mass="0.35"/>


            <!-- ================================================= -->
            <!-- LEFT LEG                                         -->
            <!-- ================================================= -->

            <body
                name="left_hip_yaw_link"
                pos="0 0.055 -0.075">

                <joint
                    name="left_hip_yaw"
                    type="hinge"
                    axis="0 0 1"
                    range="-0.4363 0.5236"/>

                <geom
                    type="cylinder"
                    axisangle="0 1 0 1.5708"
                    size="0.018 0.025"
                    mass="0.025"/>


                <body
                    name="left_hip_roll_link"
                    pos="0 0 -0.025">

                    <joint
                        name="left_hip_roll"
                        type="hinge"
                        axis="0 0 1"
                        range="-0.3840 0.3840"/>

                    <geom
                        type="box"
                        size="0.025 0.025 0.025"
                        mass="0.025"/>


                    <body
                        name="left_upper_leg"
                        pos="0 0 -0.035">

                        <joint
                            name="left_hip_pitch"
                            type="hinge"
                            axis="0 0 1"
                            range="-1.5708 1.5708"/>

                        <geom
                            type="capsule"
                            fromto="0 0 0 0 0 -0.085"
                            size="0.025"
                            mass="0.07"/>


                        <body
                            name="left_lower_leg"
                            pos="0 0 -0.085">

                            <joint
                                name="left_knee"
                                type="hinge"
                                axis="0 0 1"
                                range="-1.5708 1.5708"/>

                            <geom
                                type="capsule"
                                fromto="0 0 0 0 0 -0.075"
                                size="0.022"
                                mass="0.06"/>


                            <body
                                name="left_foot"
                                pos="0 0 -0.075">

                                <joint
                                    name="left_ankle"
                                    type="hinge"
                                    axis="0 0 1"
                                    range="-1.0 1.0"/>

                                <geom
                                    name="left_foot_geom"
                                    type="box"
                                    pos="0.025 0 -0.015"
                                    size="0.055 0.035 0.018"
                                    mass="0.05"/>

                            </body>

                        </body>

                    </body>

                </body>

            </body>


            <!-- ================================================= -->
            <!-- RIGHT LEG                                        -->
            <!-- ================================================= -->

            <body
                name="right_hip_yaw_link"
                pos="0 -0.055 -0.075">

                <joint
                    name="right_hip_yaw"
                    type="hinge"
                    axis="0 0 1"
                    range="-0.5236 0.4363"/>

                <geom
                    type="cylinder"
                    axisangle="0 1 0 1.5708"
                    size="0.018 0.025"
                    mass="0.025"/>


                <body
                    name="right_hip_roll_link"
                    pos="0 0 -0.025">

                    <joint
                        name="right_hip_roll"
                        type="hinge"
                        axis="0 0 1"
                        range="-0.3840 0.3840"/>

                    <geom
                        type="box"
                        size="0.025 0.025 0.025"
                        mass="0.025"/>


                    <body
                        name="right_upper_leg"
                        pos="0 0 -0.035">

                        <joint
                            name="right_hip_pitch"
                            type="hinge"
                            axis="0 0 1"
                            range="-1.5708 1.5708"/>

                        <geom
                            type="capsule"
                            fromto="0 0 0 0 0 -0.085"
                            size="0.025"
                            mass="0.07"/>


                        <body
                            name="right_lower_leg"
                            pos="0 0 -0.085">

                            <joint
                                name="right_knee"
                                type="hinge"
                                axis="0 0 1"
                                range="-1.5708 1.5708"/>

                            <geom
                                type="capsule"
                                fromto="0 0 0 0 0 -0.075"
                                size="0.022"
                                mass="0.06"/>


                            <body
                                name="right_foot"
                                pos="0 0 -0.075">

                                <joint
                                    name="right_ankle"
                                    type="hinge"
                                    axis="0 0 1"
                                    range="-1.0 1.0"/>

                                <geom
                                    name="right_foot_geom"
                                    type="box"
                                    pos="0.025 0 -0.015"
                                    size="0.055 0.035 0.018"
                                    mass="0.05"/>

                            </body>

                        </body>

                    </body>

                </body>

            </body>


            <!-- ================================================= -->
            <!-- NECK                                               -->
            <!-- ================================================= -->

            <body
                name="neck"
                pos="0 0 0.115">

                <joint
                    name="neck_pitch"
                    type="hinge"
                    axis="0 1 0"
                    range="-1.5708 1.0472"/>

                <geom
                    type="cylinder"
                    size="0.025 0.025"
                    mass="0.04"/>


                <!-- HEAD PITCH -->

                <body
                    name="head_pitch_link"
                    pos="0 0 0.045">

                    <joint
                        name="head_pitch"
                        type="hinge"
                        axis="0 1 0"
                        range="-1.5708 1.5708"/>

                    <geom
                        type="box"
                        size="0.035 0.035 0.025"
                        mass="0.02"/>


                    <!-- HEAD YAW -->

                    <body
                        name="head_yaw_link"
                        pos="0 0 0.035">

                        <joint
                            name="head_yaw"
                            type="hinge"
                            axis="0 0 1"
                            range="-1.2 1.2"/>

                        <geom
                            type="box"
                            size="0.04 0.04 0.035"
                            mass="0.035"/>


                        <!-- HEAD ROLL -->

                        <body
                            name="head_roll_link"
                            pos="0 0 0.045">

                            <joint
                                name="head_roll"
                                type="hinge"
                                axis="1 0 0"
                                range="-0.8 0.8"/>

                            <!-- Duck head -->
                            <geom
                                type="ellipsoid"
                                size="0.075 0.06 0.065"
                                mass="0.08"/>

                            <!-- Beak -->
                            <geom
                                type="box"
                                pos="0.065 0 -0.015"
                                size="0.045 0.035 0.018"
                                mass="0.015"/>

                        </body>

                    </body>

                </body>

            </body>

        </body>

    </worldbody>


    <!-- ====================================================== -->
    <!-- 14 MICRODUCK ACTUATORS                                -->
    <!-- ====================================================== -->

    <actuator>

        <!-- LEFT LEG -->

        <position
            name="left_hip_yaw_motor"
            joint="left_hip_yaw"
            kp="15"
            ctrlrange="-0.4363 0.5236"/>

        <position
            name="left_hip_roll_motor"
            joint="left_hip_roll"
            kp="15"
            ctrlrange="-0.3840 0.3840"/>

        <position
            name="left_hip_pitch_motor"
            joint="left_hip_pitch"
            kp="15"
            ctrlrange="-1.5708 1.5708"/>

        <position
            name="left_knee_motor"
            joint="left_knee"
            kp="15"
            ctrlrange="-1.5708 1.5708"/>

        <position
            name="left_ankle_motor"
            joint="left_ankle"
            kp="15"
            ctrlrange="-1.0 1.0"/>


        <!-- NECK / HEAD -->

        <position
            name="neck_pitch_motor"
            joint="neck_pitch"
            kp="10"
            ctrlrange="-1.5708 1.0472"/>

        <position
            name="head_pitch_motor"
            joint="head_pitch"
            kp="10"
            ctrlrange="-1.5708 1.5708"/>

        <position
            name="head_yaw_motor"
            joint="head_yaw"
            kp="10"
            ctrlrange="-1.2 1.2"/>

        <position
            name="head_roll_motor"
            joint="head_roll"
            kp="10"
            ctrlrange="-0.8 0.8"/>


        <!-- RIGHT LEG -->

        <position
            name="right_hip_yaw_motor"
            joint="right_hip_yaw"
            kp="15"
            ctrlrange="-0.5236 0.4363"/>

        <position
            name="right_hip_roll_motor"
            joint="right_hip_roll"
            kp="15"
            ctrlrange="-0.3840 0.3840"/>

        <position
            name="right_hip_pitch_motor"
            joint="right_hip_pitch"
            kp="15"
            ctrlrange="-1.5708 1.5708"/>

        <position
            name="right_knee_motor"
            joint="right_knee"
            kp="15"
            ctrlrange="-1.5708 1.5708"/>

        <position
            name="right_ankle_motor"
            joint="right_ankle"
            kp="15"
            ctrlrange="-1.0 1.0"/>

    </actuator>

</mujoco>